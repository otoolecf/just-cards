{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "just-cards",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-02-16",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"APP_NAME": "just-cards"
	}
}
