{
	"name": "just-cards",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"docs:build": "node --env-file-if-exists=.env.local scripts/build-docs.mjs",
		"build": "vite build && node scripts/export-room-worker.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"test:golden": "vitest run src/lib/rulesets/golden-evals.test.ts",
		"test:confidence": "vitest run src/lib/rulesets/confidence.test.ts src/lib/rulesets/golden-evals.test.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"cf:dev": "npm run build && npm run cf:migrate:local && wrangler dev",
		"cf:deploy": "npm run build && wrangler deploy && npm run cf:migrate:remote",
		"cf:migrate:local": "wrangler d1 migrations apply RULESETS_DB --local",
		"cf:migrate:remote": "wrangler d1 migrations apply RULESETS_DB --remote",
		"cf:types": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/worker-types.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@sveltejs/adapter-cloudflare": "^7.2.7",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^4.0.18",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"wrangler": "^4.65.0"
	},
	"dependencies": {
		"bits-ui": "^2.15.5",
		"fastmcp": "^3.33.0"
	}
}
