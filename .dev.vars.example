# Local-only development variables for `wrangler dev`.
# Copy this file to `.dev.vars` and fill in real values.

# Example:
# OPENAI_API_KEY=your-key-here
# RULESET_LLM_PRIMARY_MODEL=gpt-5-mini
# RULESET_LLM_FALLBACK_MODEL=gpt-5-mini
#
# MCP auth (choose one mode):
#
# Shared token mode:
# JUST_CARDS_MCP_AUTH_TOKEN=local-mcp-token
#
# OAuth JWT mode:
# JUST_CARDS_MCP_OAUTH_ISSUER=https://your-auth.example.com
# JUST_CARDS_MCP_OAUTH_JWKS_URL=https://your-auth.example.com/.well-known/jwks.json
# JUST_CARDS_MCP_OAUTH_AUDIENCE=just-cards-mcp
# JUST_CARDS_MCP_OAUTH_REQUIRED_SCOPES=mcp:tools mcp:resources
# JUST_CARDS_MCP_OAUTH_REALM=just-cards-mcp
# JUST_CARDS_MCP_OAUTH_ALLOWED_ALGS=RS256
# JUST_CARDS_MCP_OAUTH_CLOCK_SKEW_SECONDS=60

# Owner-only AI imports and assistant endpoints. Use a random key of at least 32
# characters; never share it in room invites. Sign in at /owner. Unset = disabled.
# OWNER_ACCESS_KEY=replace-with-a-long-random-secret
# Non-browser MCP clients also send x-just-cards-owner-key in addition to MCP auth.
